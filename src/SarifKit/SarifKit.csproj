<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>SarifKit</AssemblyName>
    <RootNamespace>SarifKit</RootNamespace>

    <!-- Native AOT and trimming -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <IsTrimmable>true</IsTrimmable>

    <Optimize>true</Optimize>

    <!-- Packaging -->
    <PackageId>SarifKit</PackageId>
    <Version>1.0.0</Version>
    <Authors>Winner-Timothy Bolorunduro</Authors>
    <Description>Zero-dependency, Native-AOT-ready reader/writer for SARIF 2.1.0.</Description>
    <PackageTags>sarif;static-analysis;json;aot;performance</PackageTags>
    <RepositoryUrl>https://github.com/bolorundurowb/sarif-kit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>assets/icon.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SarifKit.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SarifKit.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="assets" />
    <None Include="..\..\skills\**\*.md" Pack="true" PackagePath="skills\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
